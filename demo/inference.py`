# Preprocessing
# ---------------------------------------------------------------------
def preprocess_image(image_path: Union[str, Path]) -> np.ndarray:
    """
    Load and normalize an RGB photo for Model 1.

    Args:
        image_path: Path to the image file.
    Returns:
        Normalized tensor as numpy array (1, 3, H, W).
    """
    bgr = cv2.imread(str(image_path), cv2.IMREAD_COLOR)
    if bgr is None:
        raise FileNotFoundError(f"Could not read image at {image_path}.")
    return preprocess_image_from_array(bgr, is_bgr=True)

def preprocess_image_from_array(img_arr: np.ndarray, is_bgr: bool = True) -> np.ndarray:
    """
    Apply per-image min-max normalization matching the training dataset.

    Args:
        img_arr: Input numpy array (H, W, 3).
        is_bgr: Whether input is in BGR format (OpenCV default).
    Returns:
        Normalized float32 array (1, 3, H, W).
    """
    arr = img_arr.astype(np.float32)
    arr = (arr - arr.min()) / (arr.max() - arr.min() + 1e-8)
    if is_bgr:
        arr = cv2.cvtColor(arr, cv2.COLOR_BGR2RGB)

    rgb = np.transpose(arr, [2, 0, 1])
    rgb = np.expand_dims(rgb, axis=0)
    return rgb.astype(np.float32)

def run_model1(
    image_input: Union[str, Path, np.ndarray],
    model: nn.Module,
    device: Union[torch.device, str, None] = None,
) -> np.ndarray:
    """
    Run MST++ reconstruction on a single RGB input.

    Args:
        image_input: File path or numpy array (H, W, 3).
        model: The MST++ model in eval mode.
        device: Device to perform inference on.
    Returns:
        Reconstructed HSI cube as numpy array (H, W, 31).
    """
    if device is None:
        device = next(model.parameters()).device
    elif isinstance(device, str):
        device = torch.device(device)

    if isinstance(image_input, (str, Path)):
        arr = preprocess_image(image_input)
    else:
        arr = preprocess_image_from_array(image_input, is_bgr=False)

    x = torch.from_numpy(arr).to(device)

    with torch.no_grad():
        y = model(x)

    cube = y.squeeze(0).permute(1, 2, 0).cpu().numpy().astype(np.float32)
    return cube

def enhance_for_display(
    cube: np.ndarray,
    percentile_lo: float = 1.0,
    percentile_hi: float = 99.0,
) -> np.ndarray:
    """Stretch a raw cube's contrast for visualization purposes."""
    lo = np.percentile(cube, percentile_lo)
    hi = np.percentile(cube, percentile_hi)
    stretched = (cube - lo) / (hi - lo + 1e-8)
    return np.clip(stretched, 0.0, 1.0).astype(np.float32)

def compute_spectral_ratios(mean_spec: np.ndarray) -> np.ndarray:
    """
    Compute strategic spectral ratios to highlight chemical residue signatures.

    Args:
        mean_spec: 31-band mean spectrum.
    Returns:
        A 7-dimensional vector of lighting-invariant ratios.
    """
    spec = mean_spec + 1e-8
    ratios = [
        spec[30] / spec[0],   # Overall spectral slope (NIR / Blue)
        spec[15] / spec[0],   # Visible slope (Red / Blue)
        spec[30] / spec[15],  # NIR slope (NIR / Red)
        (spec[30] - spec[15]) / (spec[30] + spec[15]), # NDVI-like index
        spec[20] / spec[10],  # Middle NIR / Middle Visible
        spec[25] / spec[5],   # Deep NIR / Deep Blue
        spec[30] / spec[20],  # Deep NIR / Mid NIR
    ]
    return np.array(ratios, dtype=np.float32)

def segment_produce(
    rgb_u8: np.ndarray,
    min_saturation: float = 0.15,
    min_value: float = 0.15,
    max_value: float = 0.95,
) -> np.ndarray:
    """
    General produce mask to remove neutral backgrounds.

    Args:
        rgb_u8: Input image as uint8 (H, W, 3).
    Returns:
        Boolean mask (H, W).
    """
    rgb = rgb_u8.astype(np.float32) / 255.0
    V = np.max(rgb, axis=-1)
    Min = np.min(rgb, axis=-1)
    S = (V - Min) / (V + 1e-6)
    return (S > min_saturation) & (V > min_value) & (V < max_value)

def segment_fruit(
    rgb_u8: np.ndarray,
    *,
    red_margin_g: float = 0.06,
    red_margin_b: float = 0.10,
    min_red: float = 0.30,
    min_saturation: float = 0.25,
    min_value: float = 0.25,
) -> np.ndarray:
    """
    Color-threshold fruit mask specifically tuned for red apples.

    Args:
        rgb_u8: Input image as uint8 (H, W, 3).
    Returns:
        Boolean mask (H, W).
    """
    rgb = rgb_u8.astype(np.float32) / 255.0
    R, G, B = rgb[..., 0], rgb[..., 1], rgb[..., 2]
    V = np.max(rgb, axis=-1)
    Min = np.min(rgb, axis=-1)
    S = (V - Min) / (V + 1e-6)

    is_red = (R > G + red_margin_g) & (R > B + red_margin_b) & (R > min_red)
    is_sat = S > min_saturation
    is_bright = V > min_value
    return is_red & is_sat & is_bright

def cube_fruit_stats(cube: np.ndarray, mask: np.ndarray) -> Dict[str, Any]:
    """
    Compute statistics over the masked (fruit) pixels of a cube.

    Args:
        cube: HSI cube (H, W, 31).
        mask: Boolean mask (H, W).
    Returns:
        Dictionary containing n_pixels, mean, max, std, and per-band stats.
    """
    if mask.shape[:2] != cube.shape[:2]:
        raise ValueError(f"mask shape {mask.shape} does not match cube spatial shape {cube.shape[:2]}")
    if not mask.any():
        return {
            "n_pixels": 0,
            "mean": float("nan"),
            "max": float("nan"),
            "std": float("nan"),
            "band_means": np.zeros(cube.shape[2], dtype=np.float32),
            "per_band_max": np.zeros(cube.shape[2], dtype=np.float32),
            "per_band_std": np.zeros(cube.shape[2], dtype=np.float32),
            "empty": True,
        }
    px = cube[mask]
    return {
        "n_pixels": int(mask.sum()),
        "mean": float(px.mean()),
        "max": float(px.max()),
        "std": float(px.std()),
        "band_means": px.mean(axis=0).astype(np.float32),
        "per_band_max": px.max(axis=0).astype(np.float32),
        "per_band_std": px.std(axis=0).astype(np.float32),
        "empty": False,
    }

def snv(spectrum: np.ndarray) -> np.ndarray:
    """Perform Standard Normal Variate (SNV) transformation."""
    std = np.std(spectrum)
    if std == 0: return spectrum
    return (spectrum - np.mean(spectrum)) / std

def apply_sg_derivative(spectrum: np.ndarray, window: int = 5, order: int = 2) -> np.ndarray:
    """Compute the Savitzky-Golay 1st derivative of a spectrum."""
    return savgol_filter(spectrum, window, order, deriv=1)

def load_model2_ultra() -> Tuple[Any, Any]:
    """
    Load the Model 2 Ultra checkpoint (XGBoost + Scaler).

    Returns:
        Tuple of (XGBoost model, StandardScaler).
    """
    ckpt_path = PROJECT_DIR / "models" / "checkpoints" / "model2_ultra.pkl"
    if not ckpt_path.is_file():
        raise FileNotFoundError(f"Model 2 Ultra checkpoint not found at {ckpt_path}")
    return joblib.load(str(ckpt_path))

def predict_pesticide(
    cube: np.ndarray,
    model_checkpoint: Dict[str, Any],
    mask: Optional[np.ndarray] = None
) -> Tuple[str, float]:
    """
    Predict pesticide residue class from a reconstructed HSI cube.

    Args:
        cube: Reconstructed HSI cube (H, W, 31).
        model_checkpoint: Dict containing 'model' (XGBoost) and 'scaler' (StandardScaler).
        mask: Optional boolean mask (H, W).
    Returns:
        Tuple of (predicted_label, confidence_score).
    """
    model = model_checkpoint["model"]
    scaler = model_checkpoint["scaler"]

    if mask is not None and mask.any():
        px = cube[mask]
        mean_spec = px.mean(axis=0)
        std_spec = px.std(axis=0)
    else:
        mean_spec = cube.mean(axis=(0, 1))
        std_spec = cube.std(axis=(0, 1))

    snv_mean = snv(mean_spec)
    sg_mean = apply_sg_derivative(snv_mean)

    features = np.concatenate([mean_spec, snv_mean, sg_mean, std_spec])
    features = features.reshape(1, -1)

    features_scaled = scaler.transform(features)
    pred_class = model.predict(features_scaled)[0]
    probs = model.predict_proba(features_scaled)[0]

    label_map = {0: "Fresh", 1: "Fungicide", 2: "Insecticide"}
    return label_map[pred_class], float(probs[pred_class])

def predict_pesticide_hybrid(
    cube: np.ndarray,
    rgb_u8: np.ndarray,
    model_checkpoint: Dict[str, Any],
    mask: Optional[np.ndarray] = None
) -> Tuple[Dict[str, float], str, float]:
    """
    Predict pesticide residue using Hybrid features (RGB + HSI).

    Args:
        cube: Reconstructed HSI cube (H, W, 31).
        rgb_u8: Original RGB image as uint8 (H, W, 3).
        model_checkpoint: Dict containing 'model' and 'scaler'.
        mask: Optional boolean mask (H, W).
    Returns:
        Tuple of (all_probabilities, top_label, top_confidence).
    """
    model = model_checkpoint["model"]
    scaler = model_checkpoint["scaler"]

    # 1. RGB Features (6 dims)
    img_f = rgb_u8.astype(np.float32)
    if mask is not None and mask.any():
        rgb_pixels = img_f[mask]
        rgb_mean = np.mean(rgb_pixels, axis=0)
        rgb_std = np.std(rgb_pixels, axis=0)
    else:
        rgb_mean = np.mean(img_f, axis=(0, 1))
        rgb_std = np.std(img_f, axis=(0, 1))
    rgb_features = np.concatenate([rgb_mean, rgb_std])

    # 2. HSI Features (124 dims)
    if mask is not None and mask.any():
        px = cube[mask]
        mean_spec = px.mean(axis=0)
        std_spec = px.std(axis=0)
    else:
        mean_spec = cube.mean(axis=(0, 1))
        std_spec = cube.std(axis=(0, 1))

    snv_mean = snv(mean_spec)
    sg_mean = apply_sg_derivative(snv_mean)
    hsi_features = np.concatenate([mean_spec, snv_mean, sg_mean, std_spec])

    # 3. Combined Super-Vector (130 dims)
    features = np.concatenate([rgb_features, hsi_features]).reshape(1, -1)

    features_scaled = scaler.transform(features)
    pred_class = model.predict(features_scaled)[0]
    probs = model.predict_proba(features_scaled)[0]

    label_map = {0: "Fresh", 1: "Fungicide", 2: "Insecticide"}
    prob_map = {label_map[i]: float(probs[i]) for i in range(len(probs))}

    return prob_map, label_map[pred_class], float(probs[pred_class])

PIPELINE_TO_CHECKPOINT = {
    "A":         PROJECT_DIR / "models/checkpoints/run_trained/net_best.pth",
    "C":         PROJECT_DIR / "models/checkpoints/run_apple_spectrofood_finetuned/net_best.pth",
    "fallback":  PROJECT_DIR / "models/checkpoints/run_trained/net_best.pth",
}

def resolve_checkpoint_for_pipeline(pipeline: str) -> Path:
    """Map a pipeline name to a .pth path."""
    if pipeline not in PIPELINE_TO_CHECKPOINT:
        raise KeyError(f"Unknown pipeline {pipeline!r}")
    p = PIPELINE_TO_CHECKPOINT[pipeline]
    if not p.is_file():
        raise FileNotFoundError(f"Pipeline {pipeline!r} -> checkpoint {p} does not exist.")
    return p

from routing import route_image, RoutingDecision  # noqa: E402

def route_and_infer(
    image_path: Union[str, Path],
    *,
    model: Optional[nn.Module] = None,
    device: Union[torch.device, str, None] = None,
    skip_inference: bool = False,
) -> Tuple[RoutingDecision, Optional[np.ndarray]]:
    """
    Run the routing gate, then (if appropriate) run Model 1.

    Args:
        image_path: Path to the input RGB photo.
        model: Optional pre-loaded MST++ model.
        device: Device for inference.
        skip_inference: If True, only perform routing.
    Returns:
        Tuple of (RoutingDecision, reconstructed_cube_or_None).
    """
    decision = route_image(image_path)

    if decision.tier == 3 or decision.pipeline_to_run is None or skip_inference:
        return decision, None

    ckpt = resolve_checkpoint_for_pipeline(decision.pipeline_to_run)

    if model is None or device is None:
        loaded_model, loaded_device = load_model(ckpt, device)
        model = model or loaded_model
        device = device or loaded_device

    cube = run_model1(image_path, model, device)
    return decision, cube

