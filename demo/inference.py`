def _disable_cuda_on_tensor() -> None:
    """Replace `torch.Tensor.cuda` with a no-op to support CPU-only environments.

    `architecture/__init__.py`'s `model_generator()` calls `.cuda()` on model
    classes. We instantiate MST_Plus_Plus directly, but this patch is defensive
    to prevent crashes on CPU-only machines if refactored.
    """
    def _safe_cuda(self, *args: Any, **kwargs: Any) -> Any:  # type: ignore[override]
        return self

    torch.Tensor.cuda = _safe_cuda

_disable_cuda_on_tensor()

