def _resolve_test_dirs() -> Optional[Tuple[Path, Path]]:
    """Return (Test_RGB, Test_Spec) for the first layout that exists on disk."""
    for rgb, spec in _TEST_LAYOUTS:
        if rgb.is_dir() and spec.is_dir():
            return rgb, spec
    return None

_resolved = _resolve_test_dirs()
TEST_RGB_DIR = _resolved[0] if _resolved else _TEST_LAYOUTS[0][0]
TEST_SPEC_DIR = _resolved[1] if _resolved else _TEST_LAYOUTS[0][1]

def list_test_pairs() -> List[str]:
    """Return sorted stems of Agro-HSR test images that have BOTH a .jpg and .mat."""
    if not TEST_RGB_DIR.is_dir() or not TEST_SPEC_DIR.is_dir():
        return []
    stems: List[str] = []
    for jpg in sorted(glob.glob(str(TEST_RGB_DIR / "*.jpg"))):
        stem = Path(jpg).stem
        if (TEST_SPEC_DIR / f"{stem}.mat").is_file():
            stems.append(stem)
    return stems

def load_ground_truth_hsi(stem: str) -> np.ndarray:
    """Load the real 31-band HSI cube for a given Agro-HSR test stem."""
    import hdf5storage
    mat_path = TEST_SPEC_DIR / f"{stem}.mat"
    if not mat_path.is_file():
        raise FileNotFoundError(f"No ground-truth .mat at {mat_path}")
    mat = hdf5storage.loadmat(str(mat_path))
    if "cube" not in mat:
        raise KeyError(f"Expected key 'cube' in {mat_path}")
    return mat["cube"].astype(np.float32)

def crop_to_match(pred: np.ndarray, gt: np.ndarray) -> np.ndarray:
    """Center-crop the ground-truth cube to the predicted cube's spatial size."""
    h_g, w_g = gt.shape[:2]
    h_p, w_p = pred.shape[:2]
    if (h_g, w_g) == (h_p, w_p):
        return gt
    top = max(0, (h_g - h_p) // 2)
    left = max(0, (w_g - w_p) // 2)
    return gt[top:top + h_p, left:left + w_p, :]

def compute_metrics(
    pred: np.ndarray,
    gt: np.ndarray,
    eps: float = 1e-3,
) -> Dict[str, float]:
    """Compute MRAE, RMSE, and PSNR between a predicted and ground-truth HSI."""
    p = pred.astype(np.float32)
    g = gt.astype(np.float32)
    if p.shape != g.shape:
        raise ValueError(f"Shape mismatch: pred {p.shape} vs gt {g.shape}")

    diff = p - g
    abs_diff = np.abs(diff)
    mrae = float(np.mean(abs_diff / (np.abs(g) + eps)))
    rmse = float(np.sqrt(np.mean(diff ** 2)))

    p_lo, p_hi = float(p.min()), float(p.max())
    if p_hi - p_lo < 1e-8:
        psnr = 0.0
    else:
        p_rescaled = (p - p_lo) / (p_hi - p_lo)
        g_rescaled = np.clip(g, 0.0, 1.0)
        mse = float(np.mean((p_rescaled - g_rescaled) ** 2))
        psnr = float(10.0 * np.log10(1.0 / mse)) if mse > 0 else 100.0

    return {"mrae": mrae, "rmse": rmse, "psnr": psnr}

