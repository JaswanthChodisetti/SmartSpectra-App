def _render_routing_decision(decision: Any) -> None:
    """
    Render the routing tier badge and associated warning/rejection panels.

    Args:
        decision: RoutingDecision object returned by route_image.
    """
    tier = decision.tier
    label = decision.detected_label or "unknown"
    item_name = label.replace("a photo of ", "").strip()
    conf_pct = decision.confidence * 100

    if tier == 3:
        st.error(
            f"### ✗ Not a produce photo\n\n"
            f"This image was classified as **{item_name}** "
            f"(confidence {conf_pct:.1f}%), not as a fruit or vegetable. "
            f"SmartSpectra can only analyse apple and sweet-potato photos, "
            f"so no analysis has been run.\n\n"
            f"**Please upload a clear, close-up photo of an apple or a "
            f"sweet potato.**"
        )
        return

    if tier == 2:
        st.warning(
            f"### ⚠ Unknown produce type detected\n\n"
            f"This image was classified as **{item_name}** "
            f"(confidence {conf_pct:.1f}%), not as an apple or sweet "
            f"potato. SmartSpectra was trained specifically on apple and "
            f"sweet-potato photos, so its output for other produce is "
            f"**experimental**.\n\n"
            f"The analysis has been run in the background, but the "
            f"results are hidden below for safety. Tick "
            f"'Show result anyway' if you want to see them anyway."
        )
        return

    # Tier 1
    pipeline_name = {
        "A": "sweet-potato quality pipeline",
        "C": "apple quality pipeline",
    }.get(decision.pipeline_to_run or "", "matching quality pipeline")
    st.success(
        f"### ✓ Detected: {item_name}\n\n"
        f"Routed to the **{pipeline_name}** "
        f"(confidence {conf_pct:.1f}%)."
    )

