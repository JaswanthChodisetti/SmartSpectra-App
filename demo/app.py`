                st.subheader("Spectral signature at the centre pixel")
                fig, ax = plt.subplots(figsize=(8, 4))
                wavelengths = np.linspace(400, 1000, cube_disp.shape[2])
                cy, cx = cube_disp.shape[0] // 2, cube_disp.shape[1] // 2
                ax.plot(wavelengths, cube_disp[cy, cx, :], marker="o", markersize=3, label=f"pixel ({cy}, {cx})")
                ax.set_xlabel("Wavelength (nm)")
                ax.set_ylabel("Relative intensity (stretched, 0–1)")
                ax.set_title("Reconstructed spectral signature (centre pixel)")
                ax.grid(True, alpha=0.3)
                ax.legend(loc="best")
                fig.tight_layout()
                st.pyplot(fig)
                plt.close(fig)

