    return model, device

@st.cache_resource(show_spinner="Loading Model 2 Hybrid weights…")
def get_model2_hybrid() -> Any:
    """Load and cache the Model 2 Hybrid (XGBoost + Scaler)."""
    ckpt_path = Path(__file__).resolve().parent.parent / "models" / "checkpoints" / "model2_hybrid.pkl"
    if not ckpt_path.is_file():
        ckpt_path = Path(__file__).resolve().parent.parent / "models" / "checkpoints" / "model2_ultra.pkl"
    return joblib.load(str(ckpt_path))

def _render_pesticide_prediction(probs: Dict[str, float], label: str, confidence: float) -> None:
    """
    Render the Model 2 Hybrid prediction.
    Displays all probabilities, then finalizes if top confidence > 50%.
    """
    st.markdown("#### 📊 Triage Probability Distribution")

    cols = st.columns(3)
    for i, (cat, prob) in enumerate(probs.items()):
        cols[i].metric(cat, f"{prob:.1%}")

    st.divider()

    if confidence <= 0.50:
        st.warning(
            f"### ⚠ No Definitive Result\n\n"
            f"The model is uncertain (highest confidence: {confidence:.1%}). "
            f"The most likely category was **{label}**, but it did not meet the "
            f"50% threshold for finalization."
        )
        return

    color_map = {
        "Fresh": ("🟢", "success"),
        "Fungicide": ("🟠", "warning"),
        "Insecticide": ("🔴", "error"),
    }
    icon, st_func = color_map.get(label, ("⚪", "info"))

    st.markdown(f"### {icon} Finalized Triage Result")
    if st_func == "success":
        st.success(f"**Result:** {label} (Confidence: {confidence:.1%})")
    elif st_func == "warning":
        st.warning(f"**Result:** {label} (Confidence: {confidence:.1%})")
    elif st_func == "error":
        st.error(f"**Result:** {label} (Confidence: {confidence:.1%})")
    else:
        st.info(f"**Result:** {label} (Confidence: {confidence:.1%})")

    st.caption(
        "Prediction based on **Model 2 Hybrid (XGBoost)**. "
        "This model analyzes the reconstructed spectral shape to triage residues."
    )

