@st.cache_resource(show_spinner="Loading fine-tuned MST++ weights…")
def get_model(ckpt_path: str) -> Tuple[torch.nn.Module, torch.device]:
    """Build the model on the right device and cache it for the session."""
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
