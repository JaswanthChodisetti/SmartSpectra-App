def _render_test_set_comparison(model: torch.nn.Module, device: torch.device) -> None:
    """Render the Agro-HSR test-set comparison UI."""
    pairs = list_test_pairs()
    if not pairs:
        st.error("No Agro-HSR test pairs found. Check the project layout.")
        return

    stem = st.selectbox("Pick a test image", options=pairs, index=0)

    if not st.button(f"Run on {stem}", type="primary"):
        st.caption("👆 Press the button to run the model and compare.")
        return

    try:
        gt = load_ground_truth_hsi(stem)
    except Exception as e:
        st.error(f"Could not load ground truth: {e}")
        return

    rgb_path = TEST_RGB_DIR / f"{stem}.jpg"
    if not rgb_path.is_file():
        st.error(f"Missing input photo: {rgb_path}")
        return

    with st.spinner(f"Reconstructing HSI cube for {stem}…"):
        try:
            pred = run_model1(rgb_path, model, device)
        except Exception as e:
            st.error(f"Inference failed: {e}")
            return

    gt_aligned = crop_to_match(pred, gt)
    h, w, b = pred.shape
    st.success(f"✅ **{stem}** — predicted cube **{h}×{w}×{b}**")

    col_in, col_metrics = st.columns([1, 2])
    with col_in:
        st.image(str(rgb_path), caption=f"Input RGB ({stem}.jpg)", use_container_width=True)

    with col_metrics:
        m = compute_metrics(pred, gt_aligned)
        m1, m2, m3 = st.columns(3)
        m1.metric("MRAE", f"{m['mrae']:.4f}")
        m2.metric("RMSE", f"{m['rmse']:.4f}")
        m3.metric("PSNR", f"{m['psnr']:.2f} dB")

    _confidence_banner(m["mrae"])

    pred_disp = enhance_for_display(pred)
    gt_disp = enhance_for_display(gt_aligned)

    st.subheader("Reconstructed vs. real HSI — band slices")
    band_wavelengths = [450, 550, 700, 850]
    fig, axes = plt.subplots(2, 4, figsize=(16, 7))
    for col_i, wl in enumerate(band_wavelengths):
        b_idx = int(round((wl - 400) / 20))
        b_idx = max(0, min(30, b_idx))
        axes[0, col_i].imshow(pred_disp[:, :, b_idx], cmap="gray", vmin=0, vmax=1)
        axes[0, col_i].set_title(f"Predicted — ~{400 + b_idx * 20} nm")
        axes[0, col_i].axis("off")
        axes[1, col_i].imshow(gt_disp[:, :, b_idx], cmap="gray", vmin=0, vmax=1)
        axes[1, col_i].set_title(f"Real — ~{400 + b_idx * 20} nm")
        axes[1, col_i].axis("off")
    fig.suptitle(f"{stem} — top: predicted, bottom: real", fontsize=14)
    fig.tight_layout()
    st.pyplot(fig)
    plt.close(fig)

    st.subheader("Spectral signature at the centre pixel")
    fig2, ax2 = plt.subplots(figsize=(8, 4))
    wavelengths = np.linspace(400, 1000, pred.shape[2])
    cy, cx = pred.shape[0] // 2, pred.shape[1] // 2
    ax2.plot(wavelengths, pred[cy, cx, :], marker="o", markersize=3, label="Predicted")
    ax2.plot(wavelengths, gt_aligned[cy, cx, :], marker="s", markersize=3, label="Real")
    ax2.set_xlabel("Wavelength (nm)")
    ax2.set_ylabel("Reflectance")
    ax2.set_title(f"Centre pixel ({cy}, {cx})")
    ax2.grid(True, alpha=0.3)
    ax2.legend(loc="best")
    fig2.tight_layout()
    st.pyplot(fig2)
    plt.close(fig2)

def _apple_pixel_mask(rgb_u8: np.ndarray) -> np.ndarray:
    """Simple color-segmentation mask for red apples."""
    rgb = rgb_u8.astype(np.float32) / 255.0
    R, G, B = rgb[..., 0], rgb[..., 1], rgb[..., 2]
    V = np.max(rgb, axis=-1)
    S = (V - np.min(rgb, axis=-1)) / (V + 1e-6)
    is_red = (R > G + 0.06) & (R > B + 0.10) & (R > 0.30)
    is_saturated = S > 0.25
    is_bright = V > 0.25
    return is_red & is_saturated & is_bright

def _render_triple_checkpoint(
    model_a: torch.nn.Module,
    model_b: torch.nn.Module,
    model_c: Optional[torch.nn.Module],
    device: torch.device,
) -> None:
    """Side-by-side reconstruction comparison of three checkpoints."""
    uploaded = st.file_uploader("Upload an apple photo", type=["jpg", "jpeg", "png"], key="triple_upload")
    if not uploaded:
        st.write("⬆️ Upload an apple photo to compare the checkpoints.")
        return

    suffix = os.path.splitext(uploaded.name)[1] or ".jpg"
    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=suffix)
    try:
        tmp.write(uploaded.getbuffer())
        temp_path = tmp.name
    finally:
        tmp.close()

    try:
        from PIL import Image as PILImage
        pil = PILImage.open(temp_path).convert("RGB")
        rgb_u8 = np.array(pil, dtype=np.uint8)
        rgb_f = rgb_u8.astype(np.float32)
        rgb_minmax = (rgb_f - rgb_f.min()) / (rgb_f.max() - rgb_f.min() + 1e-8)
        rgb_t = torch.from_numpy(rgb_minmax).permute(2, 0, 1).unsqueeze(0).to(device)

        mask = _apple_pixel_mask(rgb_u8)
        pct = float(mask.mean() * 100)

        col_in, col_meta = st.columns([1, 2])
        with col_in:
            st.image(rgb_u8, caption="Input", use_container_width=True)
        with col_meta:
            st.write(f"**Apple-pixel fraction:** {pct:.1f}%")

        def _run(model: torch.nn.Module) -> np.ndarray:
            with torch.no_grad():
                cube_t = model(rgb_t).squeeze(0).cpu().numpy()
            return cube_t.transpose(1, 2, 0).astype(np.float32)

        with st.spinner("Processing checkpoints…"):
            cube_a = _run(model_a)
            cube_b = _run(model_b)
            cube_c = _run(model_c) if model_c is not None else None

        wavelengths = np.linspace(400, 1000, 31)
        panels = [(cube_a, "A — sweet-potato"), (cube_b, "B — Puvi-Lakshmi apple")]
        if cube_c is not None:
            panels.append((cube_c, "C — SpectroFood apple"))

        fig, axes = plt.subplots(1, len(panels), figsize=(7 * len(panels), 5))
        if len(panels) == 1: axes = [axes]
        for ax_i, (cube, label) in enumerate(panels):
            ax = axes[ax_i]
            ax.plot(wavelengths, cube.mean(axis=(0, 1)), marker="o", markersize=3, label="Whole image")
            if mask.any():
                ax.plot(wavelengths, cube[mask].mean(axis=0), marker="s", markersize=3, label="Apple pixels", color="#d62728")
            ax.axvline(700, color="gray", linestyle="--", alpha=0.4)
            ax.set_xlabel("Wavelength (nm)")
            ax.set_ylabel("Reflectance")
            ax.set_title(label)
            ax.set_ylim(-0.05, 1.05)
            ax.grid(True, alpha=0.3)
            ax.legend(loc="best", fontsize=9)
        fig.tight_layout()
        st.pyplot(fig)
        plt.close(fig)

        # Overlay plot
        fig_o, ax_o = plt.subplots(figsize=(9, 5))
        colors = {"A — sweet-potato": "#1f77b4", "B — Puvi-Lakshmi apple": "#2ca02c", "C — SpectroFood apple": "#d62728"}
        for cube, label in panels:
            if mask.any():
                ax_o.plot(wavelengths, cube[mask].mean(axis=0), marker="s", markersize=3, label=label, color=colors.get(label, "gray"))
        ax_o.axvline(700, color="gray", linestyle="--", alpha=0.4)
        ax_o.set_xlabel("Wavelength (nm)")
        ax_o.set_ylabel("Reflectance (apple pixels)")
        ax_o.set_title(f"Masked-spectra overlay (mask = {pct:.1f}%)")
        ax_o.set_ylim(-0.05, 1.05)
        ax_o.grid(True, alpha=0.3)
        ax_o.legend(loc="best", fontsize=10)
        fig_o.tight_layout()
        st.pyplot(fig_o)
        plt.close(fig_o)

    finally:
        try:
            os.unlink(temp_path)
        except OSError:
            pass

