        if decision.tier == 2:
            show_anyway = _tier2_show_anyway_toggle()
            if not show_anyway:
                st.caption("Pipeline result is hidden. Tick the box above to reveal it.")
                st.stop()

        if show_anyway:
            try:
                with st.spinner("Reconstructing HSI cube…"):
                    ckpt_path = resolve_checkpoint_for_pipeline(decision.pipeline_to_run)
                    model, device = get_model(str(ckpt_path))
                    cube = run_model1(rgb_u8, model, device)
            except Exception as e:
                st.error(f"Inference failed: {e}")
                st.stop()

            if cube is not None:
                h, w, b = cube.shape
                st.success(f"✅ Reconstructed cube: **{h}×{w}×{b}**")

                try:
                    with st.spinner("Triage residue via Model 2 Hybrid…"):
                        mask = segment_fruit(rgb_u8)
                        m2_hybrid = get_model2_hybrid()
                        probs, label, conf = predict_pesticide_hybrid(cube, rgb_u8, m2_hybrid)
                        _render_pesticide_prediction(probs, label, conf)
                except Exception as e:
                    st.error(f"Model 2 Hybrid prediction failed: {e}")

                with st.expander(f"🍎 Background segmentation", expanded=False):
                    pct_fruit = float(mask.mean() * 100)
                    overlay = rgb_u8.copy()
                    if mask.any():
                        overlay[~mask] = (overlay[~mask] * 0.30).astype(np.uint8)
                    else:
                        overlay[:4, :] = [255, 0, 0]
                    col_o, col_c = st.columns(2)
                    col_o.image(rgb_u8, caption="Raw input", use_container_width=True)
                    col_c.image(overlay, caption=f"After red-fruit mask ({pct_fruit:.1f}% kept)", use_container_width=True)

                stats_fruit = cube_fruit_stats(cube, mask)
                if stats_fruit["empty"] or stats_fruit["mean"] < 0.0001 or stats_fruit["max"] < 0.1:
                    st.error("🔴 **LOW CONFIDENCE** — spectral stats are outside typical range.", icon="⚠️")
                else:
                    st.success("🟢 **HIGH CONFIDENCE** — masked-cube stats are in typical range.", icon="✅")

                cube_disp = enhance_for_display(cube)
                st.subheader("Reconstructed spectral bands (sample slices)")
