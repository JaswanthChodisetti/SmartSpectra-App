# Empirical p75 MRAE from the 282-scene Agro-HSR test set.
LOW_CONFIDENCE_MRAE_THRESHOLD = 0.0326

def _confidence_banner(mrae: float) -> None:
    """
    Render a high-contrast banner indicating reconstruction reliability.

    Args:
        mrae: Mean Relative Absolute Error of the reconstructed cube.
    """
    if mrae > LOW_CONFIDENCE_MRAE_THRESHOLD:
        st.error(
            f"🔴 **LOW CONFIDENCE** — reconstruction MRAE = {mrae:.4f} "
            f"exceeds the empirical p75 threshold "
            f"({LOW_CONFIDENCE_MRAE_THRESHOLD:.4f}) from the 282-scene "
            f"Agro-HSR test set.\n\n"
            f"**Recommendation:** route this sample to lab-based pesticide "
            f"testing. The spectral shape in this image is too unusual for "
            f"the reconstruction to be trustworthy.",
            icon="⚠️",
        )
    else:
        st.success(
            f"🟢 **HIGH CONFIDENCE** — reconstruction MRAE = {mrae:.4f} "
            f"is below the empirical p75 threshold "
            f"({LOW_CONFIDENCE_MRAE_THRESHOLD:.4f}). Spectral shape is "
            f"within the expected reconstruction quality for this model.",
            icon="✅",
        )

